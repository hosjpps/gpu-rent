{
  "name": "gpu-rent-web",
  "version": "0.1.0",
  "private": true,
  "description": "Клиентская часть сервиса аренды GPU (SPA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/sizes.mjs",
    "preview": "vite preview",
