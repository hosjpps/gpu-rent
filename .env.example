# Пример переменных окружения. Скопируйте в server/.env (файл в .gitignore) и подставьте свои значения:
#   cp .env.example server/.env
# На Vercel те же переменные задаются в настройках проекта (Settings -> Environment Variables), по окружениям.
# Значения ниже — ТОЛЬКО ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ. В production каждое из них генерируется заново
# (например, openssl rand -base64 32) и нигде не публикуется.

NODE_ENV=development
# Локальный сервер слушает этот порт (на Vercel не используется)
PORT=3001

# Подключение под LOGIN-ролью gpu_rent_web (не владельцем схемы), иначе RLS и GRANT не действуют.
# На Neon: pooled endpoint и ?sslmode=require. Роль создаёт db/scripts/create_login_role.sh.
DATABASE_URL=postgres://gpu_rent_web:webdev12345@localhost:5432/gpu_rent_dev
# Пароль LOGIN-роли для db/scripts/create_login_role.sh (в самом приложении не читается)
GPU_RENT_WEB_PASSWORD=webdev12345

# Ключ шифрования переменных окружения инстансов, не короче 16 символов
ENC_KEY=local-dev-enc-key-change-me-0123456789
# Секрет подписи уведомлений платёжного шлюза (HMAC-SHA256), не короче 16 символов
WEBHOOK_SECRET=local-dev-webhook-secret-change-me
# Секрет для /api/internal/billing: Vercel Cron и GitHub Actions шлют его как Authorization: Bearer <секрет>.
# Не задан — эндпоинт выключен (локально 404, в production 503). Не короче 16 символов.
CRON_SECRET=local-dev-cron-secret-change-me

# Демо-режимы: 1 — вместо письма и платёжного шлюза ответ API содержит ссылку (подтверждения email / оплаты)
DEMO_MAIL=1
DEMO_PAYMENTS=1

# Адрес сайта без слэша на конце (для ссылок подтверждения и проверки Origin). Локально можно не задавать.
# APP_URL=https://gpu-rent.vercel.app
# Дополнительные разрешённые Origin через запятую (например, превью-развёртывания)
# ALLOWED_ORIGINS=

# Необязательные настройки (в скобках значение по умолчанию)
# BCRYPT_COST=12        # стоимость bcrypt; для локальных тестов можно снизить до 4
# DB_POOL_MAX=2         # размер пула соединений
# LOG_LEVEL=info
# COOKIE_SECURE=        # по умолчанию 1 в production, 0 иначе
# AUTH_LOGIN_EMAIL_MAX=10   # попыток входа на email за 15 минут
# AUTH_LOGIN_IP_MAX=60      # попыток входа с одного IP за 15 минут
# AUTH_REGISTER_IP_MAX=10   # регистраций с одного IP за час

# Для E2E-тестов (web/e2e): адрес проверяемого сайта и учётные данные пользователей из seed_demo.sql
# E2E_BASE_URL=http://localhost:5173
# E2E_DEMO_EMAIL=demo@gpu-rent.example
# E2E_DEMO_PASSWORD=
# E2E_ADMIN_EMAIL=admin@gpu-rent.example
# E2E_ADMIN_PASSWORD=
# E2E_CHROMIUM_PATH=       # свой Chromium, если нужный браузер Playwright не скачан
