@startuml pr22-secrets
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontSize 13
skinparam roundcorner 6
skinparam ArrowFontSize 12
skinparam nodesep 20
skinparam ranksep 30
skinparam dpi 100

title Что защищаем и в каком виде оно лежит

rectangle "Пароль пользователя\n(8–72 байта)" as P
rectangle "Токен сессии, API-ключ gr_…,\nтокен подтверждения email\n(32 случайных байта)" as T
rectangle "Секретные переменные\nокружения инстанса" as E
rectangle "Баланс и платежи" as M
rectangle "ENC_KEY, WEBHOOK_SECRET,\nCRON_SECRET, DATABASE_URL" as K

database "PostgreSQL (Neon)" as DB {
  rectangle "users.password_hash\nbcrypt, cost 12, соль внутри хэша" as H1
  rectangle "sessions, api_keys, email_tokens\nтолько SHA-256, у ключа ещё 8 символов префикса" as H2
  rectangle "instance_env_vars.value_encrypted\npgp_sym_encrypt; ключа в БД нет" as H3
  rectangle "transactions: только добавление;\nusers.balance меняет одна функция,\nпрямой UPDATE запрещён" as H4
}

rectangle "Окружение Vercel: sensitive,\nтолько Production; в git — .env.example" as VE

P --> H1
T --> H2 : показывается\nпользователю один раз
E --> H3 : ключ передаётся\nв транзакции через\nset_config(app.enc_key, …, true)
M --> H4
K --> VE
VE ..> H3 : ENC_KEY

@enduml
